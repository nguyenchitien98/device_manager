# ================================================================
# POS Management System — .gitignore
# ================================================================

# ─── Java / Maven ───────────────────────────────────────────────
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.properties
hs_err_pid*
replay_pid*

# ─── Spring Boot ─────────────────────────────────────────────────
spring-shell.log
*.log

# ─── Node.js / Angular ──────────────────────────────────────────
node_modules/
dist/
.angular/
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp/
.pnp.js
*.tgz
.npm

# ─── Angular specific ────────────────────────────────────────────
/pos-management/frontend/.angular/
/pos-management/frontend/dist/
/pos-management/frontend/node_modules/

# ─── IDE / Editors ───────────────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/
.factorypath
.vscode/
*.code-workspace
.history/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
.DS_Store
Thumbs.db

# ─── Docker ──────────────────────────────────────────────────────
# Giữ lại docker-compose.yml nhưng ignore data volumes
/pos-management/infrastructure/postgres-data/
/pos-management/infrastructure/redis-data/
/pos-management/infrastructure/kafka-data/

# ─── Environment / Secrets ───────────────────────────────────────
*.env
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
application-secret.yml
application-prod.yml
**/src/main/resources/application-prod.yml
**/src/main/resources/application-secret.yml

# ─── Certificates / Keys ─────────────────────────────────────────
*.pem
*.key
*.p12
*.jks
*.keystore
*.truststore

# ─── Test / Coverage ─────────────────────────────────────────────
/coverage/
/.nyc_output
karma-results/
test-results/

# ─── Build artifacts ─────────────────────────────────────────────
out/
build/
out-tsc/

# ─── Misc ────────────────────────────────────────────────────────
*.bak
*.tmp
*.orig
*.patch
